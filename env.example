# ============================================================
# 配置清单（本仓库不含任何真实密钥 / 主机地址）
#
# 两种配置方式（任选其一）：
#   方式 A：直接把 config_ascendc.py 中的脱敏占位替换为真实值
#           YOUR_DASHSCOPE_API_KEY / YOUR_NPU_HOST / YOUR_NPU_SSH_PASSWORD
#   方式 B（推荐，避免真实密钥落盘）：设置以下环境变量后运行脚本，
#           config_ascendc.py 会自动用环境变量覆盖占位。
#
# 注意：请勿将包含真实密钥的 config_ascendc.py 提交到公开仓库。
# ============================================================

# 真实 LLM API（阿里云百炼 / OpenAI 兼容接口）
DASHSCOPE_API_KEY=your_api_key_here

# 310B4 真机 SSH（仅 --real 模式需要）
NPU_HOST=your_npu_host_ip
NPU_USERNAME=your_npu_username
NPU_SSH_PASSWORD=your_npu_ssh_password
NPU_PORT=22
NPU_REMOTE_WORK_DIR=/home/your_npu_username/negotiation-eval
NPU_OPP_PACKAGES=/home/your_npu_username/opp_packages
